@startuml SEP_2 Class Diagram

' ==========================================================
' CONFIGURATION & STYLING
' ==========================================================
skinparam {
  classAttributeIconSize 0
  classFontStyle bold
  packageStyle rectangle
  linetype ortho
  shadowing false
  roundcorner 10

  ' Colors for packages
  PackageBackgroundColor<<Model>> #D5E8D4
  PackageBorderColor<<Model>> #82B366
  PackageBackgroundColor<<Server>> #DAE8FC
  PackageBorderColor<<Server>> #6C8EBF
  PackageBackgroundColor<<Client>> #FFF2CC
  PackageBorderColor<<Client>> #D6B656
}

hide circle
left to right direction

' ==========================================================
' MODEL package - Data Entities
' ==========================================================
package "model" <<Model>> {

  class Student <<Serializable>> {
    - serialVersionUID : long = 1L
    - studentId : int
    - name : String
    - email : String
    - password : String
    - cv : String
    - age : int
    - university : String
    - workingExperience : String
    - personalityTraits : String
    --
    + Student(studentId:int, name:String, email:String, password:String, cv:String)
    + Student(studentId:int, name:String, email:String, password:String, cv:String, age:int, university:String, workingExperience:String, personalityTraits:String)
    --
    + login(email:String, password:String) : boolean
    + logout() : void
    + getStudentId() : int
    + getName() : String
    + getEmail() : String
    + getCv() : String
    + getAge() : int
    + getUniversity() : String
    + getWorkingExperience() : String
    + getPersonalityTraits() : String
    + setStudentId(studentId:int) : void
    + setName(name:String) : void
    + setEmail(email:String) : void
    + setCv(cv:String) : void
    + setAge(age:int) : void
    + setUniversity(university:String) : void
    + setWorkingExperience(workingExperience:String) : void
    + setPersonalityTraits(personalityTraits:String) : void
    + browseInternships() : void
    + clickApply() : void
    + confirmApplication() : void
    + applyForInternship() : void
    + receiveNotification() : void
  }

  class Company <<Serializable>> {
    - serialVersionUID : long = 1L
    - companyId : int
    - companyName : String
    - email : String
    - password : String
    - description : String
    --
    + Company(companyId:int, companyName:String, email:String, password:String, description:String)
    --
    + getCompanyId() : int
    + getCompanyName() : String
    + getEmail() : String
    + getDescription() : String
    + login(email:String, password:String) : boolean
    + logout() : void
    + addInternship() : void
    + deleteInternship() : void
    + viewApplications() : void
  }

  class Internship <<Serializable>> {
    - id : int
    - title : String
    - description : String
    - companyId : int
    - location : String
    - position : String
    - startDate : LocalDate
    - endDate : LocalDate
    - status : String
    --
    + Internship(id:int, title:String, description:String, companyId:int, location:String, position:String, startDate:LocalDate, endDate:LocalDate, status:String)
    --
    + getId() : int
    + setId(id:int) : void
    + getTitle() : String
    + setTitle(title:String) : void
    + getDescription() : String
    + setDescription(description:String) : void
    + getCompanyId() : int
    + setCompanyId(companyId:int) : void
    + getLocation() : String
    + setLocation(location:String) : void
    + getPosition() : String
    + setPosition(position:String) : void
    + getStartDate() : LocalDate
    + setStartDate(startDate:LocalDate) : void
    + getEndDate() : LocalDate
    + setEndDate(endDate:LocalDate) : void
    + getStatus() : String
    + setStatus(status:String) : void
  }

  class Application <<Serializable>> {
    - applicationId : int
    - studentId : int
    - internshipId : int
    - status : String
    - applicationDate : LocalDate
    - studentName : String
    - studentAge : int
    - university : String
    - workingExperience : String
    - personalityTraits : String
    --
    + Application(applicationId:int, studentId:int, internshipId:int, status:String, applicationDate:LocalDate)
    + Application(applicationId:int, studentId:int, internshipId:int, status:String, applicationDate:LocalDate, studentName:String, studentAge:int, university:String, workingExperience:String, personalityTraits:String)
    --
    + getApplicationId() : int
    + setApplicationId(applicationId:int) : void
    + getStudentId() : int
    + setStudentId(studentId:int) : void
    + getInternshipId() : int
    + setInternshipId(internshipId:int) : void
    + getStatus() : String
    + setStatus(status:String) : void
    + getApplicationDate() : LocalDate
    + setApplicationDate(applicationDate:LocalDate) : void
    + getStudentName() : String
    + setStudentName(studentName:String) : void
    + getStudentAge() : int
    + setStudentAge(studentAge:int) : void
    + getUniversity() : String
    + setUniversity(university:String) : void
    + getWorkingExperience() : String
    + setWorkingExperience(workingExperience:String) : void
    + getPersonalityTraits() : String
    + setPersonalityTraits(personalityTraits:String) : void
    + applyForInternship() : void
    + checkStatus() : void
    + updateStatus(newStatus:String) : void
  }

  class UniversityMember {
    - universityMemberId : int
    - name : String
    - email : String
    - role : String
    --
    + UniversityMember(universityMemberId:int, name:String, email:String, role:String)
    --
    + getUniversityMemberId() : int
    + getName() : String
    + getEmail() : String
    + getRole() : String
    + monitorStudentProgress() : void
    + viewActiveCompanies() : void
  }
}

' ==========================================================
' SERVER package - Logic & Data Access
' ==========================================================
package "server" <<Server>> {

  class Server {
    - {static} PORT : int = 9090
    --
    + {static} main(args) : void
  }

  class ClientHandler <<Runnable>> {
    - socket : Socket
    - repository : InternshipRepository
    - applicationRepository : ApplicationRepository
    - userRepository : UserRepository
    --
    + ClientHandler(socket:Socket, repository:InternshipRepository, applicationRepository:ApplicationRepository, userRepository:UserRepository)
    + run() : void
  }

  class DatabaseConnection {
    - {static} URL : String
    - {static} USER : String
    - {static} PASSWORD : String
    --
    + {static} getConnection() : Connection
  }

  class UserRepository <<Repository>> {
    + loginStudent(username:String, password:String) : Student
    + loginCompany(username:String, password:String) : Company
  }

  class InternshipRepository <<Repository>> {
    + getAll() : List<Internship>
    + add(internship:Internship) : void
    + delete(id:int) : boolean
  }

  class ApplicationRepository <<Repository>> {
    + addApplication(application:Application) : boolean
    + getAllApplications() : List<Application>
    + getApplicationsByStudent(studentId:int) : List<Application>
    + getApplicationsByCompany(companyId:int) : List<Application>
    + updateApplicationStatusForCompany(applicationId:int, newStatus:String, companyId:int) : boolean
    + deleteApplication(applicationId:int) : boolean
  }

  class UniversityMemberRepository <<Repository>> {
    + getAll() : List<UniversityMember>
  }
}

' ==========================================================
' CLIENT package - UI & Network Proxy
' ==========================================================
package "client" <<Client>> {

  class Client {
    - {static} HOST : String
    - {static} PORT : int
    --
    + loginStudent(username:String, password:String) : Student
    + loginCompany(username:String, password:String) : Company
    + getAll() : List<Internship>
    + add(internship:Internship) : boolean
    + delete(id:int) : boolean
    + apply(application:Application) : boolean
    + getApplicationsByStudent(studentId:int) : List<Application>
    + getAllApplications() : List<Application>
    + getApplicationsByCompany(companyId:int) : List<Application>
    + updateApplicationStatusForCompany(applicationId:int, newStatus:String, companyId:int) : boolean
    + deleteApplication(applicationId:int) : boolean
  }

  class StudentGUI <<JFrame>> {
    - client : Client
    - currentStudent : Student
    - loggedIn : boolean
    - table : JTable
    - tableModel : DefaultTableModel
    - tfEmail : JTextField
    - pfPassword : JPasswordField
    - lblStatus : JLabel
    - lblLoggedUser : JLabel
    --
    + StudentGUI()
  }

  class CompanyGUI <<JFrame>> {
    - client : Client
    - currentCompany : Company
    - loggedIn : boolean
    - table : JTable
    - tableModel : DefaultTableModel
    - tfEmail : JTextField
    - pfPassword : JPasswordField
    - lblLoggedCompany : JLabel
    - tfTitle : JTextField
    - tfDescription : JTextField
    - tfCompanyId : JTextField
    - tfLocation : JTextField
    - tfPosition : JTextField
    - tfStartDate : JTextField
    - tfEndDate : JTextField
    - tfStatus : JTextField
    - lblStatus : JLabel
    --
    + CompanyGUI()
  }

  class UniversityMemberGUI <<JFrame>> {
    - repository : UniversityMemberRepository
    - table : JTable
    - tableModel : DefaultTableModel
    - tfEmail : JTextField
    - pfPassword : JPasswordField
    - lblLoggedUser : JLabel
    - lblStatus : JLabel
    - loggedIn : boolean
    --
    + UniversityMemberGUI()
  }
}

' ==========================================================
' RELATIONSHIPS & ASSOCIATIONS
' ==========================================================

' Domain associations with multiplicities
Company "1" -- "0..*" Internship : posts >
Student "1" -- "0..*" Application : submits >
Internship "1" -- "0..*" Application : receives >

' Client <-> Model usage (important in this repo: serialization over sockets)
Client ..> Student
Client ..> Company
Client ..> Internship
Client ..> Application

StudentGUI --> Client : requests
CompanyGUI --> Client : requests

' NOTE: UniversityMemberGUI currently uses UniversityMemberRepository directly (no sockets)
UniversityMemberGUI --> UniversityMemberRepository : uses

' Server side composition and usage
Server "1" *-- "0..*" ClientHandler : manages >
ClientHandler ..> UserRepository : uses
ClientHandler ..> InternshipRepository : uses
ClientHandler ..> ApplicationRepository : uses

UserRepository ..> DatabaseConnection : connects via
InternshipRepository ..> DatabaseConnection : connects via
ApplicationRepository ..> DatabaseConnection : connects via
UniversityMemberRepository ..> DatabaseConnection : connects via

' Note on Architecture
note top of model : Domain objects exchanged between Client and Server
note bottom of server : Backend logic and persistence layer (PostgreSQL)
note bottom of client : Swing-based Frontend and network communication

@enduml
